# Copy to .env and fill in the two keys (the brief: "IPQS key user adds to .env, GH key user adds to .env").
# .env is read by compose (env_file) and never committed.

# Guardhouse over your VPN — the deploy handout's address; change only if yours differs.
GH_API_URL=http://10.10.100.1:8080

# Guardhouse bearer token. Owner ruling 2.4-b: the token originally issued for Executor.
GH_TOKEN=

# IPQualityScore key. Owner ruling 3.3-b: the 5 000/month plan (250 lookups/day).
IPQS_KEY=

# Uuids pulled from Guardhouse at the same time (spec §2.4; keep at 2 while audit finding H2 is open).
LA_GH_CONCURRENCY=2

# Daily IPQS cap enforced by the button (Startup tier = 250/day).
LA_IPQS_DAILY_CAP=250
